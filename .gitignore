# 运行时用户数据（每次自动生成，不入版本控制）
# =====================================================================
data/memory/
data/timeline/
data/reflections/
data/personality/

# profile 目录里 PROFILE.md 是首次启动时自动写入的运行时文件
# 提交一个 .example 即可
data/profile/PROFILE.md

# =====================================================================
# 敏感配置：含真实 API key，绝不入版本控制
# 用 settings.json.example 作为提交占位
# =====================================================================
settings.json

# =====================================================================
# 临时 / ad-hoc 测试残留
# =====================================================================
tests/drive.py
tests/round-10-output.log
tests/test-script.sh
scripts/debug-tokens.ts
scripts/test-spread.ts

# R&D 评测产物：大体积 log.json（评测脚本 + REPORT.md 保留作为研究记录）
tests/scripts/manual/*.log.json

# 根目录调试脚本：send_*.py, send_*.ps1, screenshot*.py, find_*.py,
# test_*.py, attach_*.py, clipboard_*.py, console_*.py
# 不影响 tests/ 下有意义的 .ts 测试文件（被 tests/*.test.ts 显式追踪）
/send*.py
/send*.ps1
/screenshot*.py
/screenshot*.ps1
/find_*.py
/find_*.ps1
/test_*.py
/test_*.ps1
/attach_*.py
/clipboard_*.py
/console_*.py

# Anthropic SDK 等第三方工具的内部配置目录（不提交）
.claude/

# 备份文件（settings.json.bak 等）
*.bak
*.backup
*.tmp

