# EmoTalk 环境变量示例
# 复制为 .env（不提交到 git）并填入实际值，或在 settings.json 里设置。
# 也可以直接 export 这些变量到 shell 环境中。

# ====================================================================
# 必需：模型 API 凭据（至少设置一组）
# ====================================================================

# Anthropic Claude（默认 provider）
ANTHROPIC_API_KEY=sk-ant-xxxx
# 自定义 baseURL（如使用 DeepSeek / Moonshot 等 Anthropic 兼容代理时设置）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# 显式指定模型（覆盖默认的 claude-sonnet-4-5-20250929）
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI 兼容（可选，备用 provider）
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ====================================================================
# 可选：Compact 配置（历史压缩）
# ====================================================================
# EC_COMPACT_TRIGGER_AT=20
# EC_COMPACT_RECENT_KEPT=6
# EC_COMPACT_MAX_CHARS=20000

# ====================================================================
# 可选：主动对话
# ====================================================================
# EC_PROACTIVE=1
# EC_PROACTIVE_IDLE_HOURS=4
# EC_PROACTIVE_MAX_PER_DAY=2
# EC_PROACTIVE_QUIET_START=23
# EC_PROACTIVE_QUIET_END=8
# EC_PROACTIVE_COOLDOWN_MIN=60

# ====================================================================
# 可选：行为开关
# ====================================================================
# EC_AUTO_EXTRACT=0          # 设为 0 关闭自动记忆抽取
# EC_QUIET=1                 # 设为 1 显示调试标签（情绪 / 记忆 / compact）

# ====================================================================
# 可选：调试
# ====================================================================
# EC_DEBUG=1                 # 主循环详细日志
# EC_DEBUG_PROFILE=1         # profile 更新日志

# ====================================================================
# 可选：服务端口
# ====================================================================
# PORT=3000
